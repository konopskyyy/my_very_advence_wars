{
  "name": "@my-very-advance-wars/electron",
  "version": "0.0.1",
  "private": true,
  "description": "Opakowanie desktopowe dla My Very Advance Wars (placeholder).",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "start:dist": "cross-env VITE_DEV_SERVER_URL= electron .",
    "dist": "npm --prefix ../client run build && npm run start:dist",
    "build": "electron-builder --dir"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.myveryadvancewars.app",
    "productName": "My Very Advance Wars",
    "files": [
      "main.cjs",
      "preload.cjs"
    ],
    "directories": {
      "output": "release"
    }
  }
}
