<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="MVAW"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 https://pmd.sourceforge.io/ruleset_xml_schema.xsd">
    <description>Złożoność i projekt backendu; typy i martwy kod sprawdza Psalm.</description>
    <rule ref="rulesets/codesize.xml"/>
    <rule ref="rulesets/design.xml">
        <exclude name="CouplingBetweenObjects"/>
    </rule>
    <rule ref="rulesets/design.xml/CouplingBetweenObjects">
        <properties>
            <property name="maximum" value="14"/>
        </properties>
    </rule>
</ruleset>
