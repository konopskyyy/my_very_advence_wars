<!doctype html>
<html lang="pl">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Panel administratora — My Very Advance Wars</title>
        <style>
            :root { color-scheme: dark; }
            body {
                display: grid;
                place-items: center;
                min-height: 100vh;
                margin: 0;
                background: #0b0b0b;
                color: #d8e2dc;
                font-family: 'Courier New', monospace;
            }
            main {
                width: min(380px, calc(100% - 32px));
                padding: 28px;
                border: 1px solid #26352c;
                border-radius: 4px;
                background: #111a15;
            }
            h1 { margin: 0 0 8px; font-size: 20px; letter-spacing: 0.06em; }
            p { margin: 0 0 20px; color: #8fa396; font-size: 13px; line-height: 1.6; }
            label { display: flex; flex-direction: column; gap: 6px; margin-bottom: 14px; }
            span { color: #8fa396; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; }
            input {
                padding: 10px 12px;
                border: 1px solid #26352c;
                border-radius: 2px;
                background: #0a100c;
                color: #d8e2dc;
                font: inherit;
                font-size: 14px;
            }
            input:focus { border-color: #a6f4c5; outline: none; }
            button {
                width: 100%;
                padding: 12px 18px;
                border: 1px solid #a6f4c5;
                border-radius: 2px;
                background: #a6f4c5;
                color: #08120c;
                font: inherit;
                font-weight: 700;
                cursor: pointer;
            }
            .error { margin: 0 0 14px; color: #f2c97d; font-size: 13px; }
        </style>
    </head>
    <body>
        <main>
            <h1>Panel administratora</h1>
            <p>Zaloguj się kontem z rolą <code>ROLE_ADMIN</code>.</p>
            {% if error %}
                <p class="error">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
            {% endif %}
            <form action="{{ path('admin_login') }}" method="post">
                <label>
                    <span>E-mail</span>
                    <input type="email" name="_username" value="{{ last_username }}" autocomplete="username" required autofocus>
                </label>
                <label>
                    <span>Hasło</span>
                    <input type="password" name="_password" autocomplete="current-password" required>
                </label>
                <button type="submit">Zaloguj się</button>
            </form>
        </main>
    </body>
</html>
