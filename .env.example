# Skopiuj ten plik na .env i dostosuj wartości.
# Compose czyta .env automatycznie; bez niego działają wartości domyślne.

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=my_very_advance_wars
MYSQL_USER=app
MYSQL_PASSWORD=app

# Porty hosta — celowo niestandardowe, żeby ograniczyć „zgłoszenie się" po
# skanowaniu typowych portów (8080, 3306, 5173), jeśli apka trafi do sieci.
# Nadpisz w .env, jeśli musisz.
CLIENT_PORT=18573
BACKEND_PORT=18080
DB_PORT=13306
ADMINER_PORT=18081
