{
  "$schema": "https://opencode.ai/config.json",

  // Czytamy punktowo. Bez tych blokad model potrafi wciągnąć do kontekstu
  // całe dist/, node_modules/ albo vendor/, co powtarza się w każdym kroku.
  "permissions": [
    { "action": "read", "resource": "client/dist/*", "effect": "deny" },
    { "action": "read", "resource": "client/node_modules/*", "effect": "deny" },
    { "action": "read", "resource": "client/reports/*", "effect": "deny" },
    { "action": "read", "resource": "client/.stryker-tmp/*", "effect": "deny" },
    { "action": "read", "resource": "client/package-lock.json", "effect": "deny" },
    { "action": "read", "resource": "server/vendor/*", "effect": "deny" },
    { "action": "read", "resource": "server/public/game/*", "effect": "deny" },
    { "action": "read", "resource": "server/composer.lock", "effect": "deny" },
    { "action": "read", "resource": "*.log", "effect": "deny" },

    // Shell nie zastępuje read/grep/glob — inaczej jeden `grep -rn` zjada
    // cały budżet wyniku, zanim model zdąży zawęzić zapytanie.
    { "action": "shell", "resource": "cat *", "effect": "deny" },
    { "action": "shell", "resource": "sed *", "effect": "deny" },
    { "action": "shell", "resource": "head *", "effect": "deny" },
    { "action": "shell", "resource": "tail *", "effect": "deny" },
    { "action": "shell", "resource": "less *", "effect": "deny" },
    { "action": "shell", "resource": "more *", "effect": "deny" },
    { "action": "shell", "resource": "grep *", "effect": "deny" },
    { "action": "shell", "resource": "egrep *", "effect": "deny" },
    { "action": "shell", "resource": "rg *", "effect": "deny" },
    { "action": "shell", "resource": "find *", "effect": "deny" }
  ],

  // Jeden wynik narzędzia to maks. ~2 tys. tokenów. Pliki większe niż 200
  // linii lub 8 KiB trzeba czytać wycinkami (read offset/limit).
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },

  "watcher": {
    "ignore": [
      "client/dist/**",
      "client/node_modules/**",
      "client/reports/**",
      "server/vendor/**",
      "server/public/game/**"
    ]
  }
}
