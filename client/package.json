{
  "name": "@my-very-advance-wars/client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "mutation": "stryker run",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "deps:check": "depcruise --config .dependency-cruiser.cjs src",
    "deps:graph": "depcruise --config .dependency-cruiser.cjs --output-type dot src | dot -T svg > dependency-graph.svg",
    "unused": "ts-prune -p tsconfig.json",
    "dup": "jscpd src tests",
    "quality": "npm run typecheck && npm run deps:check && npm run unused && npm run dup"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "sql.js": "^1.15.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/sql.js": "^1.4.11",
    "dependency-cruiser": "^17.3.1",
    "jscpd": "^4.0.5",
    "ts-prune": "^0.10.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
