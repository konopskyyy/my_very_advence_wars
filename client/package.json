{
  "name": "@my-very-advance-wars/client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "coverage": "vitest run --coverage",
    "dev": "vite",
    "lint": "biome lint src tests",
    "metrics": "node tools/code-metrics/node_modules/code-multivitals/dist/cli.js \"src/**/*.ts\" --reporter json --output reports/multivitals.json --max-errors 10000 --max-warnings 10000",
    "mutation": "stryker run",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "deps:check": "depcruise --config .dependency-cruiser.cjs src",
    "deps:graph": "depcruise --config .dependency-cruiser.cjs --output-type dot src | dot -T svg > dependency-graph.svg",
    "unused": "knip",
    "dup": "jscpd src tests",
    "quality": "npm run typecheck && npm run lint && npm run deps:check && npm run unused && npm run dup"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "sql.js": "^1.16.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/sql.js": "^1.16.0",
    "@vitest/coverage-v8": "^5.1.1",
    "dependency-cruiser": "^18.7.2",
    "jscpd": "^5.4.3",
    "knip": "^6.45.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.0.5"
  }
}
